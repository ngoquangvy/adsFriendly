{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "AdsFriendly",
  "version": "1.3.0",
  "description": "Trinh chan popup va banner quang cao thong minh cho Safari",
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "utils/shared.js",
      "background/settings-package.js",
      "background/network.js",
      "background/whitelist.js",
      "background/telemetry.js",
      "background/neutralize.js",
      "background/tab-tracker.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [
        "utils/shared.js",
        "utils/config.js",
        "utils/helpers.js",
        "content/telemetry.js",
        "content/dom-rules.js",
        "content/ui.js",
        "content/popup-blocker.js",
        "content/injector.js",
        "content/banner-detector.js",
        "content/mutation-watcher.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{"id": "advertising", "enabled": false, "path": "packages/advertising-rules.json"}]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdsFriendly"
  },
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png"
  }
}
