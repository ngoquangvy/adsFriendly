{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "AdsFriendly",
  "version": "1.0",
  "description": "Trinh chan popup va banner quang cao thong minh cho Safari",
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background/whitelist.js",
      "background/neutralize.js",
      "background/tab-tracker.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [
        "utils/config.js",
        "utils/helpers.js",
        "content/ui.js",
        "content/injector.js",
        "content/popup-blocker.js",
        "content/banner-detector.js",
        "content/mutation-watcher.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdsFriendly"
  },
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png"
  }
}
